# REBELWEAR Frontend Environment Variables Template

# Backend API Base URL
# IMPORTANT: Must include protocol (https:// or http://)
# Local development:
VITE_API_URL=http://localhost:3001/api
VITE_BACKEND_URL=http://localhost:3001

# Production (Vercel Backend):
# VITE_API_URL=https://rebelwear.vercel.app/api
# VITE_BACKEND_URL=https://rebelwear.vercel.app

# Stripe Publishable Key
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Google Analytics 4 Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Production Canonical Site Base URL
VITE_SITE_URL=https://rebelwearstore.netlify.app
